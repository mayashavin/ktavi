{
  "name": "polira",
  "version": "0.1.0",
  "description": "A CLI-first, workflow-driven AI assistant for preparing Markdown blog drafts for publishing.",
  "type": "module",
  "bin": {
    "polira": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "markdown",
    "blog",
    "seo",
    "cli",
    "ai",
    "cover-image"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cloudinary": "^2.5.1",
    "commander": "^13.1.0",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "gray-matter": "^4.0.3",
    "openai": "^4.77.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.0.4"
  }
}
