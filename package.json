{
  "name": "ktavi",
  "version": "0.2.0",
  "description": "A CLI-first, workflow-driven AI assistant for preparing Markdown blog drafts for publishing.",
  "type": "module",
  "bin": {
    "ktavi": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepare": "husky"
  },
  "keywords": [
    "markdown",
    "blog",
    "seo",
    "cli",
    "ai",
    "cover-image"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "cloudinary": "^2.5.1",
    "commander": "^13.1.0",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "gray-matter": "^4.0.3",
    "jiti": "^2.6.1",
    "openai": "^4.77.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^3.24.1"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@types/diff": "^6.0.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^7.3.2",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^3.0.4"
  }
}
